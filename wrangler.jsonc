{
  "name": "resethook",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [{ "pattern": "resethook.example.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resethook",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "DELIVERIES", "queue": "resethook-deliveries" }],
    "consumers": [
      {
        "queue": "resethook-deliveries",
        "max_batch_size": 5,
        "max_retries": 10,
        "dead_letter_queue": "resethook-deliveries-dlq"
      }
    ]
  },
  "ratelimits": [{ "name": "API_RL", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "assets": { "directory": "./public" },
  "build": { "command": "node scripts/bundle-skill.mjs" },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_BASE_URL": "https://resethook.example.com",
    "UPSTREAM_UA": "resethook/1.0 (+https://resethook.example.com; you@example.com)",
    "TURNSTILE_SITEKEY": "",
    "MAX_FAILURES": "8"
  }
}
